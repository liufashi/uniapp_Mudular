# 公共变量说明（实际值见各环境文件）
# Vite 加载顺序：.env → .env.[mode] → .env.local → .env.[mode].local（后者覆盖前者）

# 当前环境标识：development | staging | production
# VITE_APP_ENV=

# 接口基础地址
# VITE_API_BASE=

# 是否使用 Mock 数据：true | false
# VITE_USE_MOCK=

# 微信小程序 appid（填写后运行 npm run sync:mp-appid）
# VITE_MP_WEIXIN_APPID=

# ---
# 环境文件：
#   .env.development  — npm run dev:* 默认加载
#   .env.staging      — npm run build:*:staging 加载
#   .env.production   — npm run build:* 默认加载
#   .env.local        — 个人本地覆盖（不提交 Git）
