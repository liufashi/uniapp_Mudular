{
  "name": "uniapp_Mudular",
  "version": "1.2.0",
  "description": "基于 uni-app 框架的多端开发项目",
  "main": "main.js",
  "scripts": {
    "dev:mp-weixin": "node scripts/sync-mp-appid.js --mode=development && uni -p mp-weixin",
    "build:mp-weixin": "node scripts/sync-mp-appid.js --mode=production && uni build -p mp-weixin",
    "build:mp-weixin:staging": "node scripts/sync-mp-appid.js --mode=staging && uni build -p mp-weixin --mode staging",
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "build:h5:staging": "uni build -p h5 --mode staging",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "build:app:staging": "uni build -p app --mode staging",
    "dev:app-android": "uni -p app-android",
    "build:app-android": "uni build -p app-android",
    "build:app-android:staging": "uni build -p app-android --mode staging",
    "dev:app-ios": "uni -p app-ios",
    "build:app-ios": "uni build -p app-ios",
    "build:app-ios:staging": "uni build -p app-ios --mode staging",
    "sync:mp-appid": "node scripts/sync-mp-appid.js",
    "sync:mp-appid:prod": "node scripts/sync-mp-appid.js --mode=production",
    "generate:tab-icons": "node scripts/generate-tab-icons.js"
  },
  "keywords": [
    "uni-app",
    "vue",
    "miniprogram"
  ],
  "author": "liufashi",
  "license": "MIT",
  "dependencies": {
    "@dcloudio/uni-app-plus": "^3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "^3.0.0-5000720260410001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-5000720260410001",
    "pinia": "^2.1.7",
    "sass": "^1.77.8",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "^3.0.0-5000720260410001",
    "@dcloudio/uni-cli-shared": "^3.0.0-5000720260410001",
    "@dcloudio/uni-uts-v1": "^3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "^3.0.0-5000720260410001",
    "vite": "^5.2.8"
  },
  "optionalDependencies": {
    "@dcloudio/uts-darwin-arm64": "^3.0.0-5000720260410001"
  }
}
